
# School Management System - Environment Configuration
# ==================================================

# Supabase Configuration (Optional - for cloud database)
# Get these from your Supabase project dashboard: https://app.supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Database (local SQLite or Supabase)
# Use "sqlite" for local development, "supabase" for cloud
DATABASE_TYPE=sqlite
DATABASE_URL=./data/school.db

# Application Settings
APP_NAME=Ghana School Management Platform
APP_URL=http://localhost:8000

